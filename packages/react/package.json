{
  "name": "@colada-db/react",
  "version": "0.0.0",
  "private": true,
  "description": "React binding over colada-db's adapter-facing subscription boundary (ADR-008 §3) — useSyncExternalStore hooks. PRIVATE until the boundary is frozen by two real consumers (ADR-008 §4); never published from this package.",
  "license": "MIT",
  "author": {
    "name": "Danny Devs"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "colada-db": ">=0.1.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "colada-db": "workspace:*",
    "happy-dom": "^20.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.21.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
