{
  "name": "colada-db",
  "version": "0.1.0",
  "private": true,
  "description": "AI-first, local-first client database — normalized reactive entity store with pluggable durability engines (IndexedDB, OPFS SQLite)",
  "keywords": [
    "local-first",
    "database",
    "client-database",
    "entity",
    "normalization",
    "cache",
    "offline",
    "indexeddb",
    "sqlite",
    "opfs",
    "ai-first",
    "agents"
  ],
  "homepage": "https://github.com/Danny-Devs/colada-db",
  "bugs": {
    "url": "https://github.com/Danny-Devs/colada-db/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Danny Devs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danny-Devs/colada-db.git"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./sqlite-worker": "./dist/sqlite-worker.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/check-public-types.mjs",
    "check:pack-manifest": "bash scripts/check-pack-manifest.sh",
    "check:publish-surface": "node scripts/check-publish-surface.mjs",
    "fmt": "oxfmt",
    "hooks:install": "git config core.hooksPath .githooks && echo 'pre-push hook enabled (core.hooksPath=.githooks)'",
    "hooks:uninstall": "git config --unset core.hooksPath || true; echo 'pre-push hook disabled'",
    "play": "vite playground",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test && pnpm lint && pnpm check:publish-surface && pnpm check:pack-manifest",
    "lint": "oxlint --deny-warnings . && node scripts/no-unguarded-process-env.mjs",
    "lint:fix": "oxlint --fix --deny-warnings . && node scripts/no-unguarded-process-env.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@sqlite.org/sqlite-wasm": "*",
    "@vue/reactivity": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@vue/reactivity": "^3.5.32",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.8.9",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.59.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.7.0",
    "vite": "^8.1.5",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=18"
  }
}
