-- allium: 3
--
-- colada-db — the SyncAdapter contract (Stage 3 / Phase 5)
--
-- Source of truth: docs/adr/006-sync-adapter-interface.md, frozen at rev d
-- (2026-08-02). This file is a TRANSCRIPTION of that contract into checkable
-- form, not an improvement on it. As of rev d the ADR is silent nowhere, so the
-- Open Questions section at the bottom is EMPTY — see it for why that is a
-- decision rather than an omission.
--
-- Rev d history: writing THIS FILE against rev c is what exposed 20 unresolved
-- points, four of them outright contradictions between ADR sections (DAN-736).
-- A specification forces every clause to be representable, and four were not.
-- Rev d resolved ALL TWENTY. Every "the spec takes this path" hedge that used to
-- appear in a guidance block is gone — the ADR now says which path, so this file
-- states it, and every resolution carries a falsification test instead.
--
-- Companion decisions: ADR-003 (memory projection, not store swap), ADR-004
-- (evict is not delete), ADR-005 (version metadata slot + server-authoritative
-- posture), ADR-007 (write-channel origins), ADR-014 (provenance, not phase
-- flags), ADR-022 (the irreversibility lines — the shapes below are a WIRE
-- PROTOCOL, which is one of the six surfaces that stop being ours once a real
-- backend speaks them).
--
-- Scope discipline: colada-db is a generic OSS local-first library. Nothing in
-- this file names a consuming application's domain. The adapter moves entities
-- and knows nothing about what they mean.
--
-- Written so that an executable conformance kit — the SyncAdapter sibling of
-- src/engine-conformance.ts — can be generated from it: every contract
-- signature is a call a third-party adapter must answer, every @invariant is a
-- property a spy adapter can witness, and every expression-bearing invariant is
-- a predicate over state the kit can read after a rule sequence.

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    coordinator: SyncCoordinator
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The opaque entity payload. colada-db never inspects its shape; the adapter
-- never inspects it either. Declared as a placeholder so the contract can name
-- it without owning it.
external entity EntityData {}

-- One registered entity type in the consuming app's schema. Governed by the
-- store's defineEntity surface, not by this spec.
external entity EntityTypeRegistration {
    name: String
    -- ADR-006 §5: device-local types (pagination containers, UI state) are
    -- excluded from replication. Spelled `local: true` on defineEntity — the
    -- shipped EntityDefinition name, adopted by rev d D7 over the ADR's former
    -- `sync: false`, because the code is published and the ADR was not.
    device_local: Boolean
}

-- A row in the in-memory projection. Governed by the store spec (ADR-003).
external entity StoredEntity {
    entity_type_name: String
    id: String
    registration: EntityTypeRegistration
    version: Version?
    origin: WriteOrigin?
}

-- The already-shipped optimistic transaction (0.2.0). ADR-006 §1: the outbox
-- IS this system's durable tail, not a new mechanism.
external entity OptimisticTransaction {
    transaction_id: String
}

-- The consuming application, as a party at the local-write boundary.
external entity HostApplication {
    sync_enabled: Boolean
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- Backend-supplied ordering token. ADR-005 §1 froze this as opaque and
-- never fabricated by the store; the wire form is string-or-number. Core must
-- not apply a relational operator to it — see contract VersionOrdering (C2).
value Version {
    token: String
}

-- Opaque pull position. Adapters may encode structured positions inside it
-- (Electric-style handle+offset); the coordinator treats it as bytes.
value Cursor {
    token: String
}

-- A change arriving FROM the backend. Deletes are tombstones, never omissions.
value RemoteChange {
    op: ChangeOp
    entity_type: String
    id: String
    data: EntityData?          -- absent for remove
    version: Version           -- authoritative ordering
}

-- A committed local write heading TO the backend: one outbox entry's payload.
value LocalChange {
    mutation_id: String        -- idempotency key; HLC-style time + counter + client
    client_id: String          -- opaque; see contract ClientIdentity (C3)
    seq: Integer               -- monotonic per client
    transaction_id: String?    -- groups a multi-entity optimistic transaction
    op: ChangeOp
    entity_type: String
    id: String
    data: EntityData?          -- PATCH-style dirty fields preferred over full rows
    base_version: Version?     -- the version the client last saw
    -- rev d D19. OPTIONAL. The mutation's INTENT rather than its result: a named
    -- mutator and its arguments (Zero / Replicache style), which a matched
    -- client+server pair replays server-side for true rebase. `data` stays the
    -- REQUIRED channel because a bring-your-own-backend contract cannot assume
    -- the server runs client code — an existing REST API cannot execute a
    -- function from your client bundle. An adapter that does not understand
    -- intent ignores it and applies data.
    intent: MutationIntent?
}

-- rev d D19. A named mutator and its arguments. Core never inspects `args`; it
-- is the adapter's and the backend's shared vocabulary, not this contract's.
value MutationIntent {
    name: String
    args: EntityData?
}

-- One per-mutation verdict inside a PushResult.
value PushVerdict {
    mutation_id: String
    status: VerdictStatus
    data: EntityData?
    version: Version?
    remapped_id: String?       -- temp-ID to server-ID, applied atomically
}

value PushResult {
    verdicts: List<PushVerdict>
}

-- One entry of Replicache-style lastMutationIDChanges: how far this client's
-- writes are already baked into the snapshot being pulled.
value ConfirmationMark {
    client_id: String
    seq: Integer
}

-- What pull() is asked for. Deliberately cursor-and-range shaped and nothing
-- more: there is no predicate field, because a predicate is the thing a server
-- that cannot decrypt your data can never evaluate (C1).
value PullSelection {
    cursor: Cursor?            -- null = initial sync
    limit: Integer?            -- a HINT (D8): adapter may return fewer, never more
    schema_version: String?
    -- rev d D5. Which partition to pull. An OPAQUE NAME: the adapter owns the
    -- namespace, core never parses it, and absent means the single default
    -- partition. This is the most a partition can be without foreclosing E2EE
    -- (C1) — a name is not a predicate.
    subscription: String?
}

-- The handle returned by the optional live channel.
value LiveChannel {
    open: Boolean
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract SyncTransport {
    pull: (selection: PullSelection) -> PullOutcome
    push: (batch: List<LocalChange>, schema_version: String?) -> PushResult
    subscribe: (subscription: SyncSubscription) -> LiveChannel

    @invariant PushIsDurableBeforeItResolves
        -- push MUST NOT resolve until the write is durable in the SAME store
        -- that pull() reads from. An adapter that resolves on enqueue into an
        -- asynchronous backend queue breaks sync: the coordinator will pull a
        -- snapshot that does not contain the write it was just told landed.

    @invariant RejectIsPermanentTransientIsThrown
        -- A `reject` verdict means PERMANENTLY invalid. Transient failure —
        -- network, 5xx, timeout, lock contention — is NOT a reject: the adapter
        -- signals it by failing the push call, and the coordinator retries with
        -- backoff. An adapter that returns `reject` for a transient condition
        -- causes permanent, silent data loss of a valid user write.

    @invariant RejectStillAdvancesServerSeq
        -- On reject the server MUST still advance its per-client seq. If it
        -- does not, the next push carries a seq the server reads as a gap, and
        -- the client wedges forever behind a write it can never retract.

    @invariant OrderedDeliveryPerClient
        -- Batches are delivered in seq order per client_id. The server ignores
        -- any seq <= lastSeen (idempotent replay) and rejects gaps.

    @invariant ReplayIsIdempotent
        -- Re-delivering a batch whose mutation_ids the server has already
        -- applied produces the same verdicts and no second application. This is
        -- what makes the retry in RejectIsPermanentTransientIsThrown safe.

    @invariant SelectionIsCursorAndRangeShaped
        -- ADR-006 rev c, C1 — the sharpest one-way door. pull() takes a cursor,
        -- a limit and a schema version. It does NOT take a server-evaluated
        -- predicate. An adapter is free to evaluate shapes over plaintext
        -- INSIDE itself (that is what an Electric adapter does); it must never
        -- require the coordinator to express selection as a predicate, because
        -- a relay that cannot decrypt the data can never evaluate one, and no
        -- future adapter recovers the property once core depends on it.

    @invariant IntentIsOptionalAndDataIsNotOptional
        -- rev d D19. A LocalChange MAY carry a named-mutator intent; it MUST
        -- carry data. Intent is strictly more powerful — a server that replays
        -- the mutator against post-apply state rebases properly instead of
        -- accepting or rejecting a patch computed against stale state — but
        -- requiring it would require the SERVER TO RUN CLIENT CODE, and an
        -- existing REST API cannot execute a function from your bundle. A
        -- contract that requires shared code is not backend-neutral, and
        -- backend-neutrality is this plugin's entire identity.
        --
        -- So intent is an adapter-level capability, exactly as `transform` is:
        -- the posture lives in the adapter, not the store. When a replayed
        -- intent disagrees with the submitted data, the server wins and reports
        -- it through `transform` — no new verdict is needed.

    @invariant HydrationPriorityOrdersStartsAndNeverBlocks
        -- rev d D20. Initial pulls are ISSUED in subscription priority order and
        -- are NOT awaited. Ordering the starts gets the important partition
        -- moving first; WAITING for it would let one slow high-priority
        -- partition stall everything behind it — head-of-line blocking, a worse
        -- failure than unordered hydration and far harder to diagnose. Priority
        -- adds nothing to the wire: D5 had already put the seam in the right
        -- place by making partitions independently cursored.

    @invariant SubscriptionIsAnOpaqueNameOwnedByTheAdapter
        -- rev d D5, resolving what a subscription IS. A subscription is a
        -- partition of the pull stream identified by an OPAQUE STRING. The
        -- coordinator holds that name and a cursor and nothing else; it never
        -- knows what predicate produced the partition. The adapter owns the
        -- namespace and declares the set; core never parses, validates or
        -- derives meaning from the string — the same discipline C3 imposes on
        -- client_id. An absent name means the single default partition, which
        -- is why this is additive rather than a break. The name is echoed on
        -- the outcome so a batch can be routed back to its cursor.
        --
        -- This shape is DICTATED by C1, not chosen for convenience: an opaque
        -- name is the most a partition can be without letting a server-side
        -- shape model reach the coordinator, and that door does not reopen.

    @invariant AtMostOnePushInFlightPerClient
        -- rev d D17. Ordered delivery plus "server rejects gaps" makes
        -- concurrent pushes unsound — two in flight IS a gap the moment either
        -- is retried. Push and pull MAY overlap: they are different directions,
        -- and confirming on the pull channel (§1b) is precisely what makes the
        -- overlap safe.

    @invariant TombstonesOutliveTheOldestHonouredCursor
        -- rev d D15. A backend MUST retain tombstones at least as long as the
        -- oldest cursor it will still honour, and compaction that drops them
        -- MUST invalidate the affected cursors — which the client observes as a
        -- reset directive. This turns "how long must a tombstone live?", which
        -- has no general answer, into a relation between two things the backend
        -- already knows.

    @invariant LiveChannelIsOptionalPokeFirstAndLossy
        -- subscribe is optional. When present it is a bare hint that triggers
        -- pull(); inline data is an optimization, not a delivery guarantee. The
        -- stream is licensed to drop events — a reset directive on the pull
        -- channel is the recovery path. The returned LiveChannel is disposable
        -- and closing it must stop delivery.

    @invariant SchemaVersionMismatchNeverDropsWrites
        -- rev d D12. On PULL, a backend that cannot serve the client's schema
        -- version returns a reset directive. On PUSH, it throws a typed
        -- SchemaVersionError; the coordinator SUSPENDS the outbox and surfaces
        -- the state. It does not drain it and it does not discard it. A schema
        -- bump may need an application-level migration, and the outbox is the
        -- one thing that has to survive one.

    @invariant InlineResetIsAPokeNeverAnInstruction
        -- rev d D16. Inline changes on the live channel may be applied only if
        -- they carry a cursor that advances that subscription's cursor
        -- monotonically. An inline `reset` schedules a pull and nothing else —
        -- it never discards state on its own authority. Forced by the channel's
        -- own definition above: subscribe is LICENSED TO BE LOSSY, and a lossy
        -- channel must never be able to destroy state.

    @invariant TombstonesNotOmissions
        -- A deletion arrives as an explicit `remove` change. Hard deletes with
        -- no tombstone are unsyncable: an absent row is indistinguishable from
        -- a row outside the current selection.

    @guidance
        -- The reference implementation is restAdapter, and the documented
        -- protocol is the deliverable — every adapter after it competes beneath
        -- this contract rather than replacing it. Keep pull() genuinely
        -- side-effect-free with cursor and predicate in the request body rather
        -- than the path (ADR-006 C5), so HTTP QUERY (RFC 10008) is a drop-in
        -- when rollout lands. Do not depend on QUERY yet.
}

contract VersionOrdering {
    compare_versions: (left: Version, right: Version) -> VersionOrder

    @invariant ComparatorIsTheOnlyOrdering
        -- ADR-006 rev c, C2. Every "is this newer" decision in the coordinator
        -- routes through this single adapter-supplied seam. No relational
        -- operator is ever applied to a Version token anywhere in core. Each
        -- such site would otherwise have to change the day an adapter needs a
        -- partial order.

    @invariant DefaultIsNumericThenLexicographicAndNeverConcurrent
        -- An adapter that supplies no comparator gets the default: numeric when
        -- both tokens parse as numbers, lexicographic otherwise. Overriding it
        -- is the adapter's choice, not core's. The default NEVER returns
        -- `concurrent` — which is why rev d D3's fourth value costs a
        -- server-authoritative deployment nothing at all.

    @invariant ConcurrentIsRepresentableAndAppliesRemote
        -- rev d D3. A comparator MAY return `concurrent`; the coordinator's
        -- policy is to apply the remote change, because under §6's
        -- server-authoritative posture the pull channel's arrival order is the
        -- tiebreak. An adapter that wants merge semantics resolves them INSIDE
        -- itself before emitting the change — the posture lives in the adapter,
        -- not the store (C3 §C3). The value exists so a future E2EE or CRDT-ish
        -- adapter has somewhere to put causality that today's code already
        -- routes through, rather than a comparison site that must change.

    @invariant CoreNeverInterpretsTheToken
        -- A vector clock, a Lamport-plus-actor pair or a signed blob may be
        -- smuggled into the token. Core must not parse, validate, truncate or
        -- reformat it.
}

contract ClientIdentity {
    client_id: () -> String

    @invariant OpaqueToCore
        -- ADR-006 rev c, C3. client_id is an opaque string. Core never
        -- generates one, never validates its format, and never assumes it is
        -- server-assigned, sequentially allocated or unique by fiat. A
        -- decentralized adapter must be free to put a public-key fingerprint
        -- there, because with no server there is nobody to vouch for identity.

    @invariant StablePerClient
        -- The value is stable for the lifetime of a client and shared across a
        -- tab group, so that (client_id, seq) keys the outbox durably across
        -- reloads and crashes.

    @invariant AuthenticationMaterialIsMintedAtCommitTime
        -- rev d D4, and the whole reason §1c survives C3. Any authentication
        -- material an entry carries — a signature, a MAC, a capability — is
        -- attached when the entry is COMMITTED to the outbox and persisted with
        -- it. It is never computed at push time. Mint it at push time and
        -- sibling-outbox recovery silently stops working the day client_id
        -- becomes a public key, because the adopting client cannot sign as the
        -- owner of a key it does not hold. Adoption is RELAY: the adopter
        -- forwards the entry exactly as committed, and the server verifies the
        -- entry rather than the sender.

    @invariant AdoptionIsSameDeviceOnly
        -- rev d D4. Siblings are tabs and workers sharing one StorageEngine on
        -- one device. Cross-device adoption was never in scope and would need
        -- exactly the re-authorship the invariant above rules out.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ChangeOp { set | remove }

enum VerdictStatus { ack | reject | transform }

-- rev d D3. Four-valued: three cannot say "concurrent", and C2 requires this
-- seam to be able to express a PARTIAL order. The default comparator never
-- emits `concurrent`, so the fourth value costs a server-authoritative
-- deployment nothing and keeps the HLC door open — which is what the
-- pre-publish widening of the version slot to string-or-number was for.
enum VersionOrder { older | same | newer | concurrent }

-- ADR-007 §1 write-channel vocabulary, restricted to the two origins this
-- boundary cares about. Echo suppression is by provenance (ADR-014). rev d D6
-- adopted the shipped WriteOrigin spelling `sync-pull` over the ADR's former
-- `remote`, because the code is published and the ADR was not.
enum WriteOrigin { local_mutation | sync_pull }

enum ExclusionReason { device_local | cache_eviction | local_reset }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- One installed transport. Three methods; the coordinator does the rest.
entity SyncAdapter {
    name: String
    is_installed: Boolean
    provides_live_channel: Boolean

    subscriptions: SyncSubscription with adapter = this
}

-- The module singleton: what the coordinator owns across all adapters.
entity SyncCoordinator {
    client_id: String
    next_seq: Integer

    outbox: OutboxEntry with coordinator = this
    pending_outbox: outbox where status in {pending, in_flight}
    unconfirmed_outbox: outbox where status = awaiting_confirmation
}

-- One replicated partition, pulled over one cursor.
entity SyncSubscription {
    adapter: SyncAdapter
    selection: PullSelection
    -- rev d D20. Priority-tiered hydration lives HERE and nowhere else: it is a
    -- property of a partition, not a field on the wire and not a notion the
    -- coordinator holds separately. Initial pulls are ISSUED in priority order
    -- and are NOT awaited — see rule BeginPull's guidance for why not waiting is
    -- the load-bearing half. Lower number = pulled first.
    hydration_priority: Integer
    cursor: Cursor?
    status: idle | pulling | staging | applying | resetting | stopped
    pending_batch_complete: Boolean
    reset_at: Timestamp?

    transitions status {
        idle -> pulling
        pulling -> staging
        staging -> pulling
        pulling -> applying
        pulling -> resetting
        applying -> idle
        applying -> resetting
        resetting -> idle
        idle -> stopped
        terminal: stopped
    }
}

-- A committed local write awaiting the backend's verdict. ADR-006 §1: this is
-- the existing optimistic-transaction system's durable tail, persisted through
-- the StorageEngine in a SEPARATE store from entity state.
entity OutboxEntry {
    coordinator: SyncCoordinator
    adapter: SyncAdapter
    change: LocalChange
    -- Groups the entries of one multi-entity optimistic transaction, so the
    -- backend can apply them atomically.
    transaction: OptimisticTransaction?
    entity_type: EntityTypeRegistration
    entity_id: String
    client_id: String
    seq: Integer
    mutation_id: String
    origin: WriteOrigin
    status: pending | in_flight | awaiting_confirmation | confirmed | rejected
    attempts: Integer
    retry_at: Timestamp?
    server_version: Version?
    -- Set only by the pull channel. The whole point of ADR-006 §1b is that no
    -- other code path may set it.
    confirmed_by_pull: Boolean

    ready_to_push: status = pending and (retry_at = null or retry_at <= now)

    transitions status {
        pending -> in_flight
        in_flight -> pending
        in_flight -> awaiting_confirmation
        in_flight -> rejected
        awaiting_confirmation -> confirmed
        terminal: confirmed, rejected
    }

    invariant NeverCarriesRemoteProvenance {
        origin = local_mutation
    }

    invariant DeviceLocalTypesNeverEnterTheOutbox {
        not entity_type.device_local
    }
}

-- What pull() returned. Either a batch of changes over a cursor, or an order to
-- discard the partition and start over.
entity PullOutcome {
    subscription: SyncSubscription
    kind: ChangeBatch | ResetDirective
}

variant ChangeBatch : PullOutcome {
    changes: List<RemoteChange>
    batch_cursor: Cursor
    -- false = more batches follow; the coordinator STAGES and applies only at
    -- complete, so a partial snapshot is never observable to the app.
    complete: Boolean
    confirmed_mutations: List<ConfirmationMark>
    checksum: String?
}

-- Cursor expired, compaction, DDL change or detected corruption. Discard the
-- partition and resync. Applied per subscription with jitter, never as a global
-- storm.
variant ResetDirective : PullOutcome {
    resume_cursor: Cursor?
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

-- Every value below is now SPECIFIED BY ADR-006 rev d (D8, D9, D10), not chosen
-- here. The open questions that used to shadow them are resolved and deleted.
--
-- Note what is ABSENT and why: there is no push_retry_attempt_ceiling and no
-- dead-letter queue (D9). A ceiling silently drops a user's write, and staying
-- visibly stuck is strictly better than that — correct for a job queue, wrong
-- for a local-first database where the outbox is durable and offline is
-- indefinite by design. Observability replaces truncation: a write is dropped
-- by a user or by a `reject`, never by a timer.
--
-- checksum_verification_enabled is also absent, deliberately (D11). Verification
-- is PRESENCE-driven: verify iff the adapter supplied a checksum. An adapter
-- that sends one is asserting it means something, and a flag letting the client
-- ignore it would make the field decorative.
config {
    pull_batch_limit: Integer = 500          -- D8: a HINT to the adapter
    push_retry_initial_backoff: Duration = 1.seconds
    push_retry_max_backoff: Duration = 60.seconds
    reset_resync_jitter: Duration = 30.seconds   -- D10: uniform [0, 30s), drawn
                                                 -- INDEPENDENTLY per subscription
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ── Local write path: what enters the outbox, and what never does ──────────

rule EnqueueCommittedMutation {
    when: LocalMutationCommitted(app, transaction, entity_type, entity_id, op, data)
    requires: not entity_type.device_local
    requires: op in {set, remove}
    ensures:
        OutboxEntry.created(
            coordinator: coordinator,
            entity_type: entity_type,
            entity_id: entity_id,
            client_id: coordinator.client_id,
            seq: coordinator.next_seq,
            origin: local_mutation,
            status: pending,
            attempts: 0,
            confirmed_by_pull: false
        )
        coordinator.next_seq = coordinator.next_seq + 1

    @guidance
        -- mutation_id is HLC-shaped (time + counter + client_id): unique AND
        -- ordered, so it doubles as the server's idempotency key and as a
        -- tiebreak. The commit of an optimistic transaction is what moves its
        -- mutations here; nothing else writes to the outbox.
}

rule DeviceLocalMutationIsNotReplicated {
    when: LocalMutationCommitted(app, transaction, entity_type, entity_id, op, data)
    requires: entity_type.device_local
    ensures: MutationExcludedFromSync(
        entity_type: entity_type,
        entity_id: entity_id,
        reason: device_local
    )
}

rule EvictionIsNotADeletion {
    when: StoreEvicted(app, entity_type, entity_id)
    ensures: MutationExcludedFromSync(
        entity_type: entity_type,
        entity_id: entity_id,
        reason: cache_eviction
    )

    @guidance
        -- ADR-004 at the sync boundary. `evict` drops a row from the memory
        -- projection only; it is cache management, and replicating it would
        -- delete the entity on every other device. There is no evict value in
        -- ChangeOp — the exclusion is structural, not a runtime check.
}

rule LocalResetIsNotAFleetDeletion {
    when: StoreCleared(app)
    ensures: LocalResetNotReplicated(coordinator: coordinator, reason: local_reset)

    @guidance
        -- clear() does not push deletes by default: a local reset (logout,
        -- account switch, test teardown) is not an instruction to the fleet.
        -- Fleet-wide deletion goes through ordinary removes.
}

-- ── Push path: ordered delivery, per-change verdicts ───────────────────────

rule DispatchReadyOutboxEntry {
    when: entry: OutboxEntry.ready_to_push
    requires: entry.status = pending
    ensures:
        entry.status = in_flight
        PushDispatched(
            adapter: entry.adapter,
            client_id: entry.client_id,
            seq: entry.seq,
            mutation_id: entry.mutation_id
        )
}

rule AckRecordsWatermarkOnly {
    when: AdapterDeliversVerdict(adapter, entry, verdict)
    requires: entry.status = in_flight
    requires: verdict.status = ack
    ensures:
        entry.status = awaiting_confirmation
        entry.server_version = verdict.version

    @guidance
        -- ADR-006 §1b, and the single most load-bearing rule in the push path.
        -- An ack records a server watermark. It does NOT drop the optimistic
        -- overlay. Dropping on ack is what produces the push-ack/pull-snapshot
        -- double-apply race and the ack-then-catch-up rubber-band flicker.
}

rule RejectIsPermanent {
    when: AdapterDeliversVerdict(adapter, entry, verdict)
    requires: entry.status = in_flight
    requires: verdict.status = reject
    ensures:
        entry.status = rejected
        OptimisticOverlayReverted(entry: entry)

    @guidance
        -- Permanently invalid: drop the outbox entry and revert the overlay
        -- through the existing rollback machinery. The server's obligation to
        -- advance its per-client seq anyway lives in contract SyncTransport
        -- (RejectStillAdvancesServerSeq) because only the backend can honour it.
}

rule TransformRebasesTheWrite {
    when: AdapterDeliversVerdict(adapter, entry, verdict)
    requires: entry.status = in_flight
    requires: verdict.status = transform
    ensures:
        entry.status = awaiting_confirmation
        entry.server_version = verdict.version
        ServerCorrectionApplied(entry: entry, data: verdict.data)
        if verdict.remapped_id != null:
            EntityRekeyed(
                entry: entry,
                from_id: entry.entity_id,
                to_id: verdict.remapped_id
            )

    @guidance
        -- The server rebased the write. The corrected entity replaces the
        -- optimistic one, and an id remap (temp-ID to server-ID) is applied
        -- ATOMICALLY: rekey the entity, rewrite outbox references, emit one
        -- move event. Partial application here is observable as a duplicate.
        --
        -- rev d D2 settles what rev c left contradictory. `transform` has TWO
        -- effects and they were never one operation. The id remap is IMMEDIATE
        -- — queued outbox entries still reference the temp id and would keep
        -- pushing it otherwise. The overlay drop WAITS on the pull channel,
        -- exactly like ack, because dropping on the push channel is the precise
        -- double-apply race §1b was written to kill. Hence status here is
        -- awaiting_confirmation, not confirmed. Only `reject` acts entirely on
        -- the push channel, which is safe because a reverted write has nothing
        -- left to double-apply.
}

rule TransientFailureRetriesWithBackoff {
    when: AdapterReportsTransientFailure(adapter, entry)
    requires: entry.status = in_flight
    ensures:
        entry.status = pending
        entry.attempts = entry.attempts + 1
        entry.retry_at = now + backoff_delay(
            entry.attempts,
            config.push_retry_initial_backoff,
            config.push_retry_max_backoff
        )

    @guidance
        -- A thrown push is NOT a reject. The entry stays in the outbox, the
        -- overlay stays on screen, and the coordinator retries. This is the
        -- distinction the error-taxonomy work (a ColadaDbError with codes) has
        -- to preserve when it lands: a typed error is the machine-readable form
        -- of "transient", and mapping any transient code onto `reject` would
        -- silently destroy valid user writes.
}

rule RecoverStrandedOutboxOnBoot {
    when: CoordinatorBooted(coordinator)
    for entry in OutboxEntries where status = in_flight:
        ensures: entry.status = pending

    @guidance
        -- ADR-006 §1c. Outbox entries are keyed (client_id, seq), so a booting
        -- client may find and re-push a crashed or frozen sibling tab's
        -- stranded entries without losing writes. It is safe because the server
        -- dedups by per-client seq.
        --
        -- rev d D4 reconciles this with C3, which rev c left unreconciled.
        -- Adoption is RELAY, NOT AUTHORSHIP: the adopting client forwards the
        -- entry exactly as it was committed and the server verifies the entry
        -- rather than the sender, so an adopter never needs to authenticate as
        -- the owner of a client_id it does not hold. What makes that true is a
        -- commit-time obligation — see contract ClientIdentity
        -- (AuthenticationMaterialIsMintedAtCommitTime, AdoptionIsSameDeviceOnly).
}

-- ── Confirmation: the overlay is dropped on the PULL channel, never on ack ──

rule ConfirmOnPulledMutationMark {
    when: PullSnapshotConfirmed(subscription, entry, mark)
    requires: entry.status = awaiting_confirmation
    requires: entry.client_id = mark.client_id
    requires: entry.seq <= mark.seq
    ensures:
        entry.status = confirmed
        entry.confirmed_by_pull = true
        OptimisticOverlayDropped(entry: entry)
}

-- rev d D1: rule ConfirmOnPulledCheckpoint IS DELETED, and its trigger
-- PullCheckpointReached with it. §1b used to offer a second confirmation path —
-- "a pulled checkpoint >= the ack's serverVersion" — which `allium analyse`
-- flagged as a dead trigger because PullResult carries no checkpoint field for
-- it to travel in.
--
-- It was deleted rather than built, and the reason is NOT that it was
-- unimplemented. A checkpoint comparison asks "is checkpoint >= serverVersion",
-- which presumes versions are TOTALLY ordered — and C2 exists precisely to keep
-- them partially ordered so a vector clock or HLC stays representable. Keeping
-- both paths meant keeping one that only works when the other constraint is
-- switched off. ConfirmOnPulledMutationMark above is now the sole confirmation
-- channel, and it costs a backend nothing extra: per-client seq tracking is
-- already mandatory (LocalChange.seq, contract OrderedDeliveryPerClient).

-- ── Pull path: cursor-based, batched, resumable, staged until complete ─────

rule BeginPull {
    when: PullRequested(subscription)
    requires: subscription.status = idle
    -- rev d D20. On initial hydration the coordinator issues these in ascending
    -- hydration_priority and DOES NOT AWAIT completion between them. Ordering
    -- the starts is what gets gates on a phone screen before history backfills;
    -- awaiting would turn one slow partition into a stall for every partition
    -- behind it. Not waiting is the load-bearing half of this decision.
    ensures:
        subscription.status = pulling
        PullDispatched(
            adapter: subscription.adapter,
            client_id: coordinator.client_id,
            seq: 0,
            mutation_id: ""
        )
        PullSelectionIssued(
            subscription: subscription,
            cursor: subscription.cursor,
            limit: config.pull_batch_limit
        )

    @guidance
        -- A null cursor means initial sync. The selection carries a cursor and
        -- a limit and nothing else — see contract SyncTransport's
        -- SelectionIsCursorAndRangeShaped for why there is no predicate here.
}

rule ResumeStagedPull {
    when: PullRequested(subscription)
    requires: subscription.status = staging
    ensures:
        subscription.status = pulling
        PullSelectionIssued(
            subscription: subscription,
            cursor: subscription.cursor,
            limit: config.pull_batch_limit
        )
}

rule PokeTriggersPull {
    when: AdapterEmitsPoke(adapter)
    requires: adapter.provides_live_channel
    for subscription in adapter.subscriptions where status = idle:
        ensures: PullRequested(subscription: subscription)

    @guidance
        -- Poke-first. The live channel says "something changed"; the pull
        -- channel says what. Inline data on the stream is an optimization and
        -- the stream is allowed to drop events, so nothing here may be the only
        -- delivery path for a change.
}

rule StageIncompletePullBatch {
    when: AdapterDeliversPullOutcome(adapter, subscription, outcome)
    requires: subscription.status = pulling
    requires: outcome.kind = ChangeBatch
    requires: not outcome.complete
    ensures:
        subscription.status = staging
        subscription.cursor = outcome.batch_cursor
        subscription.pending_batch_complete = false
        PullRequested(subscription: subscription)

    @guidance
        -- The cursor is persisted per batch, so an interrupted multi-batch pull
        -- resumes where it stopped instead of restarting. The staged changes are
        -- NOT applied — a half-applied snapshot is a corrupt one.
}

rule ApplyCompletePullBatch {
    when: AdapterDeliversPullOutcome(adapter, subscription, outcome)
    requires: subscription.status = pulling
    requires: outcome.kind = ChangeBatch
    requires: outcome.complete
    ensures:
        subscription.status = applying
        subscription.cursor = outcome.batch_cursor
        subscription.pending_batch_complete = true
        for change in outcome.changes:
            RemoteChangeReceived(subscription: subscription, change: change)
        PullBatchApplied(subscription: subscription, outcome: outcome)
}

rule ResetOnAdapterDirective {
    when: AdapterDeliversPullOutcome(adapter, subscription, outcome)
    requires: subscription.status = pulling
    requires: outcome.kind = ResetDirective
    ensures:
        subscription.status = resetting
        subscription.cursor = outcome.resume_cursor
        subscription.reset_at = now
        PartitionDiscarded(subscription: subscription)

    @guidance
        -- Cursor expiry, compaction, a DDL change or detected corruption. The
        -- entity partition is discarded and resynced. The OUTBOX is not: it
        -- lives in a separate durable store precisely so a state reset can
        -- never destroy unpushed writes.
        --
        -- rev d D13 settles what rev c left silent: a SERVER-DIRECTED reset does
        -- not invalidate in-flight mutation_ids or seqs either. The client
        -- resumes pushing the same seq range. Reset is a statement about the
        -- PULL stream; seq is a fact about the WRITE stream, tracked per client
        -- on the server. The two are independent, which is the same reason the
        -- outbox lives in its own store to begin with.
}

rule ResetOnChecksumMismatch {
    when: PullBatchApplied(subscription, outcome)
    requires: subscription.status = applying
    requires: outcome.kind = ChangeBatch
    requires: outcome.checksum != null
    requires: not checksum_matches(outcome.checksum, subscription)
    ensures:
        subscription.status = resetting
        subscription.reset_at = now
        PartitionDiscarded(subscription: subscription)

    @guidance
        -- rev d D11. Verification is PRESENCE-driven, not flag-driven: there is
        -- no longer a config switch, because an adapter that sends a checksum is
        -- asserting it means something and a flag letting the client ignore it
        -- would make the field decorative. The reset is scoped to THIS
        -- subscription and no other.
}

rule CompleteApplyAndConfirm {
    when: PullBatchApplied(subscription, outcome)
    requires: subscription.status = applying
    requires: outcome.kind = ChangeBatch
    requires:
        outcome.checksum = null
        or checksum_matches(outcome.checksum, subscription)
    ensures:
        subscription.status = idle
        for mark in outcome.confirmed_mutations:
            for entry in OutboxEntries
                where client_id = mark.client_id and seq <= mark.seq:
                PullSnapshotConfirmed(
                    subscription: subscription,
                    entry: entry,
                    mark: mark
                )
}

rule ResyncAfterResetWithJitter {
    when: subscription: SyncSubscription.reset_at + config.reset_resync_jitter <= now
    requires: subscription.status = resetting
    ensures:
        subscription.status = idle
        PullRequested(subscription: subscription)

    @guidance
        -- Jittered and per subscription. A reset that fires simultaneously
        -- across every partition is a thundering herd aimed at the backend that
        -- just told you it was in trouble.
}

rule StopSubscription {
    when: SyncDisabled(app, subscription)
    requires: subscription.status = idle
    ensures:
        subscription.status = stopped
        LiveChannelClosed(subscription: subscription)
}

-- ── Applying remote changes: version-aware, under remote provenance ────────

rule ApplyNewerRemoteChange {
    when: RemoteChangeReceived(subscription, change)
    let current = StoredEntity{entity_type_name: change.entity_type, id: change.id}
    requires:
        not exists current
        or current.version = null
        or compare_version(change.version, current.version) in {newer, concurrent}
    ensures: RemoteChangeApplied(
        subscription: subscription,
        change: change,
        origin: sync_pull
    )

    @guidance
        -- ADR-006 §2 and §3 together. The change is applied under the
        -- `sync-pull` provenance stamp (ADR-014), which is what keeps it from
        -- re-entering the outbox as though the user had typed it — echo
        -- suppression by construction rather than by a phase flag. And it is
        -- applied only if the comparator says so, upgrading ADR-005's fresh-wins
        -- from existence-based to version-based. A `remove` change is a SEMANTIC
        -- delete (store.remove, durable row deleted), never an evict.
        --
        -- rev d D3 adds the `concurrent` arm. A remote change the comparator
        -- cannot order against the local one is APPLIED: under §6's
        -- server-authoritative posture the pull channel's arrival order is the
        -- tiebreak. An adapter wanting merge semantics resolves them inside
        -- itself before emitting the change.
}

rule IgnoreDeviceLocalTypeOnPullChannel {
    when: RemoteChangeReceived(subscription, change)
    let registration = EntityTypeRegistration{name: change.entity_type}
    requires: exists registration
    requires: registration.device_local
    ensures: RemoteChangeSkipped(subscription: subscription, change: change)

    @guidance
        -- rev d D18, and the half that is NOT symmetric with the other. An
        -- UNREGISTERED type arriving on pull is applied: the store keys rows by
        -- Typename:id and needs no definition to hold one (EntityDefinition is
        -- consumed by normalize.ts alone, never by store.ts), so what is lost is
        -- nested-ref normalization, not the data.
        --
        -- A DEVICE-LOCAL type is different in kind. `local: true` is the
        -- CLIENT'S declaration that this type never leaves the device, so
        -- receiving one back means the server holds data it should never have
        -- had. Dropping it is correct, and saying so out loud is how anyone
        -- finds out — this skip is expected to be observable, not silent.
}

rule SkipStaleRemoteChange {
    when: RemoteChangeReceived(subscription, change)
    let current = StoredEntity{entity_type_name: change.entity_type, id: change.id}
    requires: exists current
    requires: current.version != null
    requires: compare_version(change.version, current.version) in {older, same}
    ensures: RemoteChangeSkipped(subscription: subscription, change: change)

    @guidance
        -- rev d D3. This used to read `!= newer`, which silently swept
        -- `concurrent` into the skip arm the moment the fourth value existed —
        -- exactly the kind of site C2 warns about. The two rules now enumerate
        -- the enum between them, so adding a fifth value would fail to compile
        -- rather than fail silently.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Idempotency. The mutation_id is the server's dedup key; two outbox entries
-- sharing one would make replay indistinguishable from a second write.
invariant UniqueMutationIdentity {
    for a in OutboxEntries:
        for b in OutboxEntries:
            a != b implies a.mutation_id != b.mutation_id
}

-- Recovery keying (ADR-006 §1c). A sibling client's stranded outbox can only be
-- adopted safely if (client_id, seq) identifies an entry uniquely. This is also
-- the property that must survive C3: it holds whatever a client_id turns out to
-- be, including a public key, because nothing here reads inside the string.
invariant OutboxIsKeyedByClientAndSeq {
    for a in OutboxEntries:
        for b in OutboxEntries:
            a != b implies (a.client_id != b.client_id or a.seq != b.seq)
}

-- ADR-006 §1b, stated as state rather than as sequence: an entry can only be in
-- the confirmed state if the pull channel put it there. This is the assertion a
-- conformance kit checks after driving ack-without-pull.
invariant OverlayIsDroppedOnlyByThePullChannel {
    for entry in OutboxEntries:
        entry.status = confirmed implies entry.confirmed_by_pull
}

-- ADR-006's staging rule: while a multi-batch pull is in progress the partition
-- has not been declared complete, so nothing from it is applied.
invariant StagedBatchesAreNotApplied {
    for subscription in SyncSubscriptions:
        subscription.status = staging implies not subscription.pending_batch_complete
}

-- A stopped subscription holds no cursor obligation and issues no pulls.
invariant StoppedSubscriptionsAreQuiescent {
    for subscription in SyncSubscriptions:
        subscription.status = stopped implies subscription.reset_at = null
}

-- rev d D14. An id remap rewrites dependent queued entries' ids AND CLEARS
-- their base_version: that version referred to a version of an entity that no
-- longer exists under that key, so carrying it forward asserts something false.
-- For a dependent already PUSHED under the old id, the server owns the remap and
-- applies it to entries it has already accepted — the client's rewrite is local
-- bookkeeping and never a second request.
invariant RemappedEntriesCarryNoStaleBaseVersion {
    for entry in OutboxEntries:
        entry.status in {pending, in_flight} and entry.change.id != entry.entity_id
            implies entry.change.base_version = null
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- The external party at the transport boundary is code, not a person.
actor AdapterImplementation {
    identified_by: SyncAdapter where is_installed
}

actor Application {
    identified_by: HostApplication where sync_enabled
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface SyncTransportBoundary {
    facing adapter: AdapterImplementation

    exposes:
        adapter.name
        adapter.provides_live_channel
        for subscription in adapter.subscriptions:
            subscription.cursor
            subscription.status

    provides:
        AdapterDeliversPullOutcome(adapter, subscription, outcome)
        AdapterDeliversVerdict(adapter, entry, verdict)
        AdapterReportsTransientFailure(adapter, entry)
        AdapterEmitsPoke(adapter) when adapter.provides_live_channel

    contracts:
        demands SyncTransport
        demands VersionOrdering
        demands ClientIdentity

    @guarantee ServerIsAuthoritative
        -- ADR-006 §6. The server's verdict is final; the client rebases
        -- in-flight optimistic transactions on the post-apply state by
        -- clear-and-replay, which the transaction system already implements.
        -- No CRDTs, no peer-to-peer merge — deliberately (ADR-005 §3). The
        -- posture lives in the ADAPTER, not in the store: an end-to-end
        -- encrypted relay adapter simply never emits a transform verdict, and
        -- the coordinator already handles adapters that do not.

    @guarantee SelectionStaysClientSideExpressible
        -- Door-keeping constraint C1. Server-evaluated shapes are permitted
        -- INSIDE an adapter and nowhere else. The coordinator's model of "what
        -- do I have, what am I missing" stays cursor-and-range shaped.

    @guarantee VersionOrderingIsDelegated
        -- Door-keeping constraint C2. Every ordering decision crosses this
        -- boundary through compare_versions. Core contains no comparison of
        -- version tokens.

    @guarantee ClientIdentityIsOpaque
        -- Door-keeping constraint C3. client_id crosses the boundary as bytes.
        -- Core neither mints nor inspects it.

    @guarantee EvictNeverCrossesTheBoundary
        -- ADR-004. ChangeOp has no evict value. Local cache management is
        -- structurally incapable of instructing the fleet to delete data.

    @guarantee EchoSuppressionByProvenance
        -- Remote changes are applied under a remote origin stamp, so they can
        -- never re-enter the outbox and bounce back to the server.

    @guidance
        -- Adapter roadmap (ADR-006 rev c): restAdapter, then an Electric
        -- read-path adapter that fills pull() and subscribe() and leaves push()
        -- to the outbox, then re-evaluate. Most sync engines in the field own
        -- their own client store and upload queue, which makes them rivals to
        -- this library rather than transports beneath it.
}

surface LocalWriteBoundary {
    facing app: Application

    provides:
        LocalMutationCommitted(app, transaction, entity_type, entity_id, op, data)
        StoreEvicted(app, entity_type, entity_id)
        StoreCleared(app)
        SyncDisabled(app, subscription)
        CoordinatorBooted(coordinator)

    @guarantee BootIsARecoveryPoint
        -- Boot is a boundary event, not an internal one: it is the moment a
        -- client may adopt the stranded outbox of a crashed sibling tab.

    @guarantee OutboxSurvivesStateReset
        -- The outbox is persisted through the StorageEngine in a SEPARATE
        -- file or store from entity state, so neither a local clear() nor a
        -- server-directed partition reset can destroy an unpushed write.

    @guarantee ClearDoesNotPushDeletes
        -- A local reset is not an instruction to the fleet.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- NONE. This section is empty by decision, and that emptiness is the point.
--
-- ADR-006 rev d (2026-08-02) resolved all 20 questions this section carried.
-- Eighteen came from writing this file against rev c: prose tolerates a clause
-- with no referent and a specification does not, so transcribing the contract
-- exposed four outright contradictions between ADR sections and one dead
-- trigger `allium analyse` found on its own. The last two -- named-mutator
-- rebase (D19) and priority-tiered hydration (D20) -- had been carried as open
-- by the ADR itself since rev b, and a rev-d draft nearly carried them again as
-- "additive later, not one-way doors."
--
-- That justification was wrong and is worth recording here, because this is the
-- file where the temptation recurs. It is true of the FIELDS and false of the
-- CONTRACT: adding a second way to express a write to a protocol other people's
-- servers already speak forces every adapter thereafter to handle both. A
-- deferral does not avoid that cost; it buys it at a worse price later.
--
-- The general rule, which governs whatever revision comes next:
--
--   The old reason to leave a specification unfinished was that BUILDING
--   TEACHES YOU THINGS, so learning beat guessing. When implementation is cheap
--   and the thinking is the expensive part, that trade inverts. A hole in a spec
--   is not humility -- it is a decision handed to whoever implements it, who
--   will fill it by accident and make it permanent.
--
-- What survives from the old instinct is not the blank. It is writing down what
-- would prove the decision WRONG. Every D-numbered resolution in ADR-006 rev d
-- carries a falsification test instead of a hedge, and a resolution whose test
-- fires is how this section legitimately gets a new entry.
